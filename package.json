{
	"name": "cleanfolio-svelte",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm generate-images && vite build",
		"build:local": "pnpm generate-images && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"generate-images": "tsx scripts/generate-image-assets.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250913.0",
		"@eslint/js": "^9.35.0",
		"@sveltejs/adapter-cloudflare": "^7.2.3",
		"@sveltejs/kit": "^2.39.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/vite": "^4.1.13",
		"@types/node": "^24.3.3",
		"@typescript-eslint/eslint-plugin": "^8.43.0",
		"@typescript-eslint/parser": "^8.43.0",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.35.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.3",
		"globals": "^16.4.0",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.38.10",
		"svelte-check": "^4.3.1",
		"svelte-typewriter": "^3.2.3",
		"tailwindcss": "^4.1.13",
		"tslib": "^2.8.1",
		"tsx": "^4.20.5",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.43.0",
		"vite": "^7.1.5",
		"vite-imagetools": "^8.0.0",
		"workers-og": "^0.0.27",
		"wrangler": "^4.36.0"
	},
	"type": "module",
	"dependencies": {
		"@lucide/svelte": "^0.544.0",
		"svelte-inview": "^4.0.4"
	},
	"packageManager": "pnpm@10.14.0"
}
